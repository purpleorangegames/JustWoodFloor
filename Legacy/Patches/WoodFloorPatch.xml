<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/TerrainDef[defName="WoodPlankFloor"]/designatorDropdown</xpath>
        <nomatch Class="PatchOperationSequence">
          <operations>
            <li Class="PatchOperationAdd">
            <xpath>Defs/TerrainDef[defName="WoodPlankFloor"]</xpath>
            <value>
                <designatorDropdown>Vanilla_Floor_JustWood</designatorDropdown>
            </value>
            </li>
            <li Class="PatchOperationAttributeAdd">
                <xpath>Defs/TerrainDef[defName="WoodPlankFloor"]</xpath>
                <attribute>Name</attribute>
                <value>WoodPlankBase</value>
            </li>
          </operations>
        </nomatch>
        <match Class="PatchOperationSequence">
          <operations>
            <li Class="PatchOperationReplace">
            <xpath>Defs/TerrainDef[defName="WoodPlankFloor"]/designatorDropdown</xpath>
            <value>
                <designatorDropdown>Vanilla_Floor_JustWood</designatorDropdown>
            </value>
            </li>
          </operations>
        </match>
    </Operation>
    
</Patch>

